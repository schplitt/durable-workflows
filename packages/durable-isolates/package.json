{
  "name": "durable-isolates",
  "version": "0.0.0",
  "type": "module",
  "description": "The replay kernel for durable-workflows: durably execute one isolate program over a log, built on top of iso4",
  "keywords": [
    "durable",
    "durable-execution",
    "replay",
    "sandbox",
    "iso4",
    "typescript",
    "esm"
  ],
  "license": "MIT",
  "author": "schplitt",
  "homepage": "https://github.com/schplitt/durable-workflows/tree/main/packages/durable-isolates#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/schplitt/durable-workflows.git",
    "directory": "packages/durable-isolates"
  },
  "bugs": {
    "url": "https://github.com/schplitt/durable-workflows/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./types/iso4": {
      "types": "./dist/types/iso4.d.mts",
      "import": "./dist/types/iso4.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@iso4/sandbox": "catalog:"
  },
  "devDependencies": {
    "@schplitt/eslint-config": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
