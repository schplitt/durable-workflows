{
  "name": "@schplitt/durable-workflows",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "description": "A composable durable workflow library inspired by Cloudflare Workflows, built on top of iso4",
  "keywords": [
    "workflow",
    "durable",
    "durable-execution",
    "step",
    "sandbox",
    "iso4",
    "typescript",
    "esm"
  ],
  "license": "MIT",
  "author": "schplitt",
  "homepage": "https://github.com/schplitt/durable-workflows#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/schplitt/durable-workflows.git"
  },
  "bugs": {
    "url": "https://github.com/schplitt/durable-workflows/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "prerelease": "eslint && tsc --noEmit && tsdown && vitest run",
    "release": "bumpp",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@iso4/sandbox": "catalog:",
    "@schplitt/eslint-config": "catalog:",
    "bumpp": "catalog:",
    "changelogithub": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
